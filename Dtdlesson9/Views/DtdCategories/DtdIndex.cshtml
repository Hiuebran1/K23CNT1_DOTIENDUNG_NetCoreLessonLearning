@model IEnumerable<Dtdlesson9.Models.Category>

@{
    ViewData["Title"] = "Danh sách loại sách";
}

<h1 class="text-center">@ViewData["Title"]</h1>
<div class="d-flex flex-row-end bd-highlight">
    <form class="d-flex" method="get" asp-action="DtdIndex" asp-controller="DtdCategories">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" name="keyword" />
        <button class="btn btn-outline-success" type="submit">Search</button>
    </form>
</div>
<p>
    <a asp-action="DtdCreate">Thêm mới</a>
</p>
<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayNameFor(modelItem => item.CategoryId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>
                <td>
                    <a asp-action="DtdEdit" asp-route-dtdid="@item.CategoryId" class="btn btn-primary">Sửa</a>
                    <a asp-action="DtdDetails" asp-route-dtdid="@item.CategoryId" class="btn btn-info">Xem</a>
                    <a asp-action="DtdDelete" asp-route-dtdid="@item.CategoryId" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Tổng số: @Model.Count()</th>
        </tr>
    </tfoot>
</table>